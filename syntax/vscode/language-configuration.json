{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((def|class|module|expect|schema|tool|guard|skill|decide|agent|flow|within|retry_up_to|mcp_server|a2a_agent|if|elsif|else|unless|case|when|while|until|begin|rescue|ensure|errors)\\b.*|\\S.*\\bdo\\b(\\s*\\|[^|]*\\|)?\\s*(#.*)?)$",
    "decreaseIndentPattern": "^\\s*(end|elsif|else|when|rescue|ensure|errors)\\b"
  }
}
