{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIL Env",
  "scopeName": "source.ail.env",
  "patterns": [
    {
      "name": "comment.line.number-sign.ail.env",
      "match": "#.*$"
    },
    {
      "name": "storage.modifier.secret.ail.env",
      "match": "\\bsecret\\b"
    },
    {
      "match": "\\b(llm|s1|embedder|db|vector_db|mcp|skills)\\.([a-zA-Z_][a-zA-Z0-9_-]*)",
      "captures": {
        "1": { "name": "support.type.resource.ail.env" },
        "2": { "name": "variable.other.binding.ail.env" }
      }
    },
    {
      "name": "string.quoted.double.ail.env",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "variable.other.env.ail.env",
          "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
        },
        {
          "name": "constant.character.escape.ail.env",
          "match": "\\\\[\"\\\\/bfnrt]"
        }
      ]
    },
    {
      "name": "constant.numeric.ail.env",
      "match": "\\b-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    {
      "name": "constant.language.ail.env",
      "match": "\\b(true|false|null)\\b"
    }
  ]
}
