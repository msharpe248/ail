{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIL",
  "scopeName": "source.ail",
  "patterns": [
    { "include": "#comments" },
    { "include": "#heredocs" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#symbols" },
    { "include": "#variables" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ail",
          "match": "#.*$"
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.line.ail",
      "begin": "#\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.ail" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.ail" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.ail",
      "match": "\\\\(x[0-9a-fA-F]{2}|[nrt0e\\\\\"'#])"
    },
    "heredocs": {
      "patterns": [
        {
          "name": "string.unquoted.heredoc.ail",
          "begin": "<<~?([A-Z_][A-Z0-9_]*)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.ail" }
          },
          "end": "^\\s*\\1$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.ail" }
          },
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ail",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.ail",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ail",
              "match": "\\\\[\\\\']"
            }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.ail",
          "begin": "(?<=(^|[\\s(\\[,=~!]))/(?![/*\\s])",
          "end": "/[ims]*",
          "patterns": [
            {
              "name": "constant.character.escape.ail",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*[?!]?)",
          "captures": {
            "1": { "name": "keyword.control.def.ail" },
            "2": { "name": "entity.name.function.ail" }
          }
        },
        {
          "match": "\\b(class|module|schema|guard|agent|flow)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.ail" },
            "2": { "name": "entity.name.type.class.ail" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ai.ail",
          "match": "\\b(schema|tool|guard|skill|decide|agent|flow|within|retry_up_to|mcp_server|a2a_agent)\\b"
        },
        {
          "name": "keyword.other.directive.ail",
          "match": "\\b(config|errors|field|param|returns|capabilities|limits|model|system|tools|mcp|skills|guards|context_view|check_input|check_output|check_tool|instructions|choice|score|prob|start|node|edge|expose|resource|prompt|handle)\\b"
        },
        {
          "name": "keyword.control.import.ail",
          "match": "\\b(expect|require|require_relative|include)\\b"
        },
        {
          "name": "keyword.control.ail",
          "match": "\\b(def|end|class|module|if|elsif|else|unless|case|when|while|until|for|in|do|begin|rescue|ensure|raise|return|break|next|yield)\\b"
        },
        {
          "name": "keyword.operator.logical.ail",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.ail",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.self.ail",
          "match": "\\bself\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ail",
          "match": "\\b(puts|print|eputs|gets|sleep_ms|budget|read_only|read_write|allow|reject|redact|escalate)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.class.ail",
          "match": "\\b(Int|Float|Decimal|Bool|String|Array|Hash|Range|Regex|Symbol|Duration|Any|Enum|Context|LogView|Knowledge|MCP|A2A|Config|File|Files|Path|OS|JSON|Env|Time|Math|Random|Agent|Flow|Schema|Tool|Guard|GuardResult|RuntimeError|TypeError|NoMethodError|KeyError|SchemaError|PermissionError|BudgetExceeded|GuardViolation|GuardEscalation|ConfigError|LLMError|System1Error|MCPError|A2AError|ToolError|EmbedderError|VectorError|FlowError)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.ail",
          "match": "\\b\\d[0-9_]*(\\.\\d[0-9_]*)?\\.(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.decimal.ail",
          "match": "\\b\\d[0-9_]*(\\.\\d[0-9_]*)?d\\b"
        },
        {
          "name": "constant.numeric.float.ail",
          "match": "\\b\\d[0-9_]*\\.\\d[0-9_]*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ail",
          "match": "\\b\\d[0-9_]*\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.hashkey.ail",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*[?!]?:(?!:)"
        },
        {
          "name": "constant.other.symbol.ail",
          "match": "(?<!:):[a-zA-Z_][a-zA-Z0-9_]*[?!]?"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.instance.ail",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.other.readwrite.global.ail",
          "match": "\\$(llm|s1|embedder|db|vector_db|mcp|skills|a2a)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow.ail",
          "match": "-->"
        },
        {
          "name": "keyword.operator.ail",
          "match": "->|=>|=~|!~|\\|\\|=|\\|\\||&&|\\.\\.\\.|\\.\\.|==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/%<>=!&|?:]"
        }
      ]
    }
  }
}
