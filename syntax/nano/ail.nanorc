## GNU nano syntax highlighting for AIL (AI Language)
## Include in ~/.nanorc:
##   include "/path/to/ail/syntax/nano/ail.nanorc"

syntax ail "\.ail$"
comment "#"

# Core keywords
color brightmagenta "\<(def|end|class|module|include|use|require|require_relative|if|elsif|else|unless|case|when|while|until|for|in|do|begin|rescue|ensure|raise|return|break|next|yield|and|or|not)\>"

# First-class AI keywords
color brightcyan "\<(schema|tool|guard|skill|decide|agent|flow|within|retry_up_to|mcp_server|a2a_agent)\>"

# AI DSL directives
color cyan "\<(field|param|returns|capabilities|limits|model|system|tools|mcp|skills|guards|context_view|check_input|check_output|check_tool|instructions|choice|score|prob|start|node|edge|expose|resource|prompt|handle)\>"

# Builtins
color yellow "\<(puts|print|eputs|gets|sleep_ms|budget|read_only|read_write|allow|reject|redact|escalate)\>"

# Types, stdlib modules & exceptions
color green "\<(Int|Float|Decimal|Bool|String|Array|Hash|Range|Regex|Symbol|Duration|Any|Enum|Context|LogView|Knowledge|MCP|Config|File|Files|Path|OS|JSON|Env|Time|Math|Random|RuntimeError|TypeError|NoMethodError|KeyError|SchemaError|PermissionError|BudgetExceeded|GuardViolation|GuardEscalation|ConfigError|LLMError|System1Error|MCPError|ToolError|EmbedderError|VectorError|FlowError)\>"

# Constants, symbols & instance variables
color brightyellow "\<(true|false|nil|self)\>"
color magenta ":[a-zA-Z_][a-zA-Z0-9_]*[?!]?"
color brightblue "@[a-zA-Z_][a-zA-Z0-9_]*"

# Numbers, decimals & durations
color brightred "\<[0-9][0-9_]*(\.[0-9_]+)?(\.(ms|s|m|h)|d)?\>"

# Flow arrow
color brightcyan "-->"

# Strings & escapes
color brightgreen "\"(\\.|[^\"])*\""
color brightgreen "'(\\.|[^'])*'"
color yellow "#\{[^}]*\}"

# Comments
color brightblack "#.*$"
