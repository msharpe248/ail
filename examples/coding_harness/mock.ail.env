# examples/coding_harness/mock.ail.env — Deterministic scripted coding-agent session
# Turn 1: reads README.md lines 1-3 and attempts to write build/harness_demo.txt
# Turn 2: edits build/harness_demo.txt from v0.1 -> v0.5
# Turn 3: summarizes the completed read & edit
llm.coder = {"driver": "mock", "script": [{"content": "", "tool_calls": [{"id": "t1", "name": "read_file", "arguments": {"path": "README.md", "start_line": 1, "end_line": 3}}, {"id": "t2", "name": "write_file", "arguments": {"path": "build/harness_demo.txt", "content": "AIL harness demo v0.1\n"}}]}, {"content": "", "tool_calls": [{"id": "t3", "name": "edit_file", "arguments": {"path": "build/harness_demo.txt", "target": "v0.1", "replacement": "v0.5"}}]}, {"content": "Read README.md and updated build/harness_demo.txt to v0.5."}]}
