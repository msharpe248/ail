# examples/agent_mock.ail.env — Deterministic mock + live stdio MCP + JSONL db + Skills
llm.assistant = {"driver": "mock", "script": [{"content": "", "tool_calls": [{"id": "c1", "name": "load_skill", "arguments": {"name": "math-helper"}}, {"id": "c2", "name": "word_count", "arguments": {"text": "ail agents on mlwsvm"}}]}, {"content": "Counted 4 words; contact 123-45-6789"}]}
llm.summarizer = {"driver": "mock", "reply": "Summary of earlier turns"}
mcp.repo_tools = {"transport": "stdio", "cmd": ["./ail", "run", "examples/mcp_repo_tools.ail", "--", "--stdio"]}
skills.local = {"driver": "dir", "paths": ["./examples/skills"]}
db.demo_sessions = {"driver": "jsonl", "path": "/tmp/ail_v02_demo_session.jsonl"}
