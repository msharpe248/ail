# examples/a2a_poker/ollama.ail.env — Live local Ollama powering all 3 A2A Poker Agents
# You can also override individual seats (llm.vega, llm.lou, llm.bayes) with different models
# or point a2a.vega / a2a.lou / a2a.bayes to external A2A HTTP servers!
llm.poker = {"driver": "openai", "url": "http://127.0.0.1:11434/v1", "model": "gemma4:31b-mlx", "think": false, "reasoning_effort": "none", "timeout_ms": 120000}
