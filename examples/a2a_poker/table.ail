# examples/a2a_poker/table.ail — 3-Agent A2A No-Limit Texas Hold'em Poker Table
#
# Launches 3 autonomous A2A HTTP agent servers (Vega, Lucky Lou, Prof. Bayes),
# discovers each player's Agent Card over HTTP (/.well-known/agent.json),
# and deals a 3-hand No-Limit Texas Hold'em match over real A2A JSON-RPC 2.0!
#
# Run live against local Ollama:
#   ./ail run examples/a2a_poker/table.ail --env examples/a2a_poker/ollama.ail.env
# Run deterministic offline test:
#   ./ail run examples/a2a_poker/table.ail --env examples/a2a_poker/mock.ail.env

require "./cards"
require "./players"

# Verify base LLM binding & default per-seat models to $llm[:poker] if not overridden
expect config do
  $llm[:poker]
errors |errs|
  errs.each do |e|
    eputs "\e[31mMissing config #{e.key}:\e[0m #{e.reason}"
  end
  eputs "Run with: ./ail run examples/a2a_poker/table.ail --env examples/a2a_poker/ollama.ail.env"
  OS.exit(1)
end

expect config do
  $llm[:vega]
  $llm[:lou]
  $llm[:bayes]
errors |errs|
  base = $llm[:poker].to_h
  errs.each do |e|
    $llm[e.name] = base
  end
end

# Optional deterministic RNG seed for repeatable tests
seed_str = Env.get("AIL_POKER_SEED", "")
Random.seed(seed_str.to_i) unless seed_str.empty?

# ---- Helpers ----

def extract_json_obj(raw)
  s = raw.strip
  # Find first '{' and last '}'
  chars = s.chars
  first = -1
  last = -1
  i = 0
  while i < chars.size
    if chars[i] == "{" && first < 0
      first = i
    end
    if chars[i] == "}"
      last = i
    end
    i += 1
  end
  return nil if first < 0 || last <= first
  begin
    JSON.parse(s.slice(first, last - first + 1))
  rescue RuntimeError => _e
    nil
  end
end

def seat_color(idx, text)
  if idx == 0
    "\e[1;36m#{text}\e[0m"
  elsif idx == 1
    "\e[1;33m#{text}\e[0m"
  else
    "\e[1;35m#{text}\e[0m"
  end
end

def print_table_banner(model_name, num_hands)
  puts ""
  puts "\e[1;32m╭──────────────────────────────────────────────────────────────────╮\e[0m"
  puts "\e[1;32m│\e[0m  \e[1m♠ ♥ AIL A2A Texas Hold'em Table ♦ ♣\e[0m                             \e[1;32m│\e[0m"
  puts "\e[1;32m├──────────────────────────────────────────────────────────────────┤\e[0m"
  puts "   \e[2mProtocol:\e[0m A2A over HTTP (Agent Cards + JSON-RPC 2.0 message/send)"
  puts "   \e[2mModel:\e[0m    \e[1m#{model_name}\e[0m  ·  \e[2mHands:\e[0m #{num_hands}  ·  \e[2mBlinds:\e[0m 10/20"
  puts "\e[1;32m╰──────────────────────────────────────────────────────────────────╯\e[0m"
  puts ""
end

def count_in_hand(seats)
  n = 0
  seats.each { |p| n += 1 unless p["folded"] }
  n
end

def count_can_act(seats)
  n = 0
  seats.each { |p| n += 1 if !p["folded"] && p["chips"] > 0 }
  n
end

def post_chips(p, amount, pot)
  paid = amount > p["chips"] ? p["chips"] : amount
  p["chips"] = p["chips"] - paid
  p["street_bet"] = p["street_bet"] + paid
  p["total_bet"] = p["total_bet"] + paid
  pot + paid
end

# Ask a player agent over A2A HTTP what action they want to take
def ask_player_a2a(seat, idx, street, board, pot, current_bet, seats, history, hand_num)
  to_call = current_bet - seat["street_bet"]
  to_call = 0 if to_call < 0
  opponents = []
  seats.each do |o|
    next if o["id"] == seat["id"]
    st = o["folded"] ? "folded" : "#{o["chips"]} chips"
    opponents.push("#{o["label"]}(#{st})")
  end

  prompt = <<~MSG
    Texas Hold'em Hand ##{hand_num} | Street: #{street}
    Your private hole cards: #{cards_plain(seat["hole"])}
    Community board: #{cards_plain(board)}
    Pot: #{pot} | Your chips: #{seat["chips"]} | To call: #{to_call}
    Opponents: #{opponents.join(", ")}
    Recent actions: #{history.empty? ? "none" : history.join("; ")}
    Choose your action now as JSON.
  MSG

  # Send the turn over HTTP JSON-RPC 2.0 (`message/send`) to this player's A2A server.
  # If the remote agent errors or times out, fall back safely to check/fold so the game continues.
  raw = begin
    seat["client"].send(prompt, id: "hand-#{hand_num}-#{street}-#{seat["id"]}")
  rescue A2AError => e
    eputs "   \e[31m[A2A error from #{seat["label"]}: #{e.message}]\e[0m"
    fallback_act = to_call == 0 ? "check" : "fold"
    return { action: fallback_act, amount: 0, quip: "(disconnected)" }
  end

  parsed = extract_json_obj(raw)
  action = "call"
  amount = 20
  quip = ""
  if parsed != nil
    action = parsed.fetch("action", "call").to_s.downcase.strip
    amount = parsed.fetch("amount", 20).to_i
    quip   = parsed.fetch("quip", "").to_s.strip
  end

  # Normalize illegal moves cleanly
  if to_call == 0
    action = "check" if action == "fold" || action == "call"
  else
    action = "call" if action == "check"
  end
  if action != "fold" && action != "check" && action != "call" && action != "raise"
    action = to_call == 0 ? "check" : "call"
  end

  # Return the normalized player decision hash
  return { action: action, amount: amount, quip: quip }
end

# Run one betting street (capped at 1 raise per street for snappy, realistic play)
def run_betting_street(street, seats, start_idx, board, pot, current_bet, history, hand_num)
  return pot if count_in_hand(seats) <= 1
  return pot if count_can_act(seats) <= 1 && current_bet == 0

  raises = 0
  acted = 0
  needed = seats.size
  idx = start_idx

  while acted < needed
    break if count_in_hand(seats) <= 1
    p = seats[idx]
    to_call = current_bet - p["street_bet"]
    to_call = 0 if to_call < 0

    if p["folded"] || p["chips"] == 0
      acted += 1
      idx = (idx + 1) % seats.size
      next
    end

    dec = ask_player_a2a(p, idx, street, board, pot, current_bet, seats, history, hand_num)
    act = dec["action"]
    amt = dec["amount"]
    quip = dec["quip"]

    # Enforce max 1 raise per street so agents don't infinite-min-raise
    if act == "raise" && (raises >= 1 || p["chips"] <= to_call)
      act = to_call == 0 ? "check" : "call"
    end

    quip_fmt = quip.empty? ? "" : "  \e[2m\"#{quip}\"\e[0m"
    tag = seat_color(idx, p["label"])

    if act == "fold"
      p["folded"] = true
      history.push("#{p["label"]} folded")
      puts "   #{tag} \e[31mfolds\e[0m#{quip_fmt}"
      acted += 1
    elsif act == "check"
      history.push("#{p["label"]} checked")
      puts "   #{tag} \e[2mchecks\e[0m#{quip_fmt}"
      acted += 1
    elsif act == "call"
      paid = to_call > p["chips"] ? p["chips"] : to_call
      pot = post_chips(p, paid, pot)
      history.push("#{p["label"]} called #{paid}")
      puts "   #{tag} \e[36mcalls #{paid}\e[0m \e[2m(pot: #{pot})\e[0m#{quip_fmt}"
      acted += 1
    elsif act == "raise"
      inc_amt = amt < 20 ? 20 : amt
      inc_amt = 60 if inc_amt > 60
      total_needed = to_call + inc_amt
      paid = total_needed > p["chips"] ? p["chips"] : total_needed
      pot = post_chips(p, paid, pot)
      if p["street_bet"] > current_bet
        current_bet = p["street_bet"]
        raises += 1
        acted = 1
        needed = seats.size
      else
        acted += 1
      end
      history.push("#{p["label"]} raised to #{current_bet}")
      puts "   #{tag} \e[1;32mraises to #{current_bet}\e[0m \e[2m(pot: #{pot})\e[0m#{quip_fmt}"
    end

    idx = (idx + 1) % seats.size
  end

  pot
end

# ---- Main Tournament Entrypoint ----

num_hands = 3
args = OS.args
if args.size > 0
  n = args[0].to_i
  num_hands = n if n > 0
end

model_label = $llm[:poker].fetch("model", $llm[:poker].fetch("driver", "unknown"))
print_table_banner(model_label, num_hands)

# Start 3 live A2A HTTP agent servers (each on an ephemeral localhost port)
# unless external $a2a[:vega] / $a2a[:lou] / $a2a[:bayes] URLs were configured in .ail.env!
handles = []

def setup_seat(id, label, desc, agent_obj, res_ref, handles)
  url = ""
  if res_ref.exists?
    url = res_ref["url"]
  else
    h = A2A.start(id, agent_obj, host: "127.0.0.1", port: 0, version: "1.0.0", description: desc)
    handles.push(h)
    url = h.url
  end

  # Connect over HTTP and fetch the agent's Agent Card (GET /.well-known/agent.json)
  cl = nil
  card = nil
  begin
    cl = A2A.connect(url)
    card = cl.card
  rescue A2AError => e
    eputs "\e[31mFailed to connect to A2A player '#{label}' at #{url}: #{e.message}\e[0m"
    handles.each { |h| h.stop }
    OS.exit(1)
  rescue ConfigError => e
    eputs "\e[31mInvalid A2A config for '#{label}': #{e.message}\e[0m"
    handles.each { |h| h.stop }
    OS.exit(1)
  end

  # Return the initialized seat state hash
  return {
    id: id,
    label: label,
    url: url,
    client: cl,
    card: card,
    chips: 500,
    hole: [],
    folded: false,
    street_bet: 0,
    total_bet: 0
  }
end

begin
  seats = [
    setup_seat("vega-the-shark", "Vega",       "Tight-aggressive Texas Hold'em pro",          VegaAgent,  $a2a[:vega],  handles),
    setup_seat("lucky-lou",      "Lucky Lou",  "Loose-aggressive gambler and trash talker",   LouAgent,   $a2a[:lou],   handles),
    setup_seat("prof-bayes",     "Prof. Bayes","Analytical pot-odds poker strategist",        BayesAgent, $a2a[:bayes], handles)
  ]

  puts "\e[1mDiscovered A2A Players (via GET /.well-known/agent.json):\e[0m"
  si = 0
  while si < seats.size
    s = seats[si]
    puts "  Seat #{si + 1}: #{seat_color(si, s["label"])}  \e[2m(#{s["card"]["name"]} @ #{s["url"]})\e[0m — #{s["card"]["description"]}"
    si += 1
  end
  puts ""

  hand = 1
  while hand <= num_hands
    # Rebuy any busted player with 500 so all 3 stay in the demo
    seats.each do |p|
      if p["chips"] <= 0
        p["chips"] = 500
        puts "   \e[2m(#{p["label"]} rebuys for 500 chips)\e[0m"
      end
      p["folded"] = false
      p["street_bet"] = 0
      p["total_bet"] = 0
      p["hole"] = []
    end

    dealer = (hand - 1) % 3
    sb_idx = (dealer + 1) % 3
    bb_idx = (dealer + 2) % 3
    utg_idx = dealer

    deck = new_shuffled_deck()
    di = 0
    # Deal 2 hole cards to each player
    round = 0
    while round < 2
      seats.each do |p|
        p["hole"].push(deck[di])
        di += 1
      end
      round += 1
    end

    puts "\e[2m────────────────────────────────────────────────────────────────────\e[0m"
    puts "\e[1;37mHAND ##{hand}\e[0m  \e[2m(Button: #{seats[dealer]["label"]} · SB: #{seats[sb_idx]["label"]} 10 · BB: #{seats[bb_idx]["label"]} 20)\e[0m"

    pot = 0
    pot = post_chips(seats[sb_idx], 10, pot)
    pot = post_chips(seats[bb_idx], 20, pot)

    si = 0
    while si < seats.size
      p = seats[si]
      puts "   #{seat_color(si, p["label"])} \e[2m[#{p["chips"]} chips]\e[0m  hole: #{cards_pretty(p["hole"])}"
      si += 1
    end

    board = []
    history = []

    # 1. Pre-Flop
    puts "  \e[1m[Pre-Flop]\e[0m \e[2m(pot: #{pot})\e[0m"
    pot = run_betting_street("Pre-Flop", seats, utg_idx, board, pot, 20, history, hand)

    # 2. Flop (3 cards)
    if count_in_hand(seats) > 1
      board.push(deck[di]); di += 1
      board.push(deck[di]); di += 1
      board.push(deck[di]); di += 1
      seats.each { |p| p["street_bet"] = 0 }
      puts "  \e[1m[Flop]\e[0m     #{cards_pretty(board)}  \e[2m(pot: #{pot})\e[0m"
      pot = run_betting_street("Flop", seats, sb_idx, board, pot, 0, history, hand)
    end

    # 3. Turn (1 card)
    if count_in_hand(seats) > 1
      board.push(deck[di]); di += 1
      seats.each { |p| p["street_bet"] = 0 }
      puts "  \e[1m[Turn]\e[0m     #{cards_pretty(board)}  \e[2m(pot: #{pot})\e[0m"
      pot = run_betting_street("Turn", seats, sb_idx, board, pot, 0, history, hand)
    end

    # 4. River (1 card)
    if count_in_hand(seats) > 1
      board.push(deck[di]); di += 1
      seats.each { |p| p["street_bet"] = 0 }
      puts "  \e[1m[River]\e[0m    #{cards_pretty(board)}  \e[2m(pot: #{pot})\e[0m"
      pot = run_betting_street("River", seats, sb_idx, board, pot, 0, history, hand)
    end

    # 5. Settlement / Showdown
    remaining = seats.select { |p| !p["folded"] }
    if remaining.size == 1
      w = remaining[0]
      w["chips"] = w["chips"] + pot
      puts "  \e[1;32m★ #{w["label"]} wins pot of #{pot} chips uncontested!\e[0m"
    else
      puts "  \e[1m[Showdown]\e[0m Board: #{cards_pretty(board)}"
      best_score = -1
      winners = []
      best_name = ""
      remaining.each do |p|
        ev = evaluate_hand(p["hole"] + board)
        puts "   #{p["label"]}: #{cards_pretty(p["hole"])}  => \e[1m#{ev["name"]}\e[0m"
        if ev["score"] > best_score
          best_score = ev["score"]
          best_name = ev["name"]
          winners = [p]
        elsif ev["score"] == best_score
          winners.push(p)
        end
      end
      share = pot / winners.size
      winners.each { |w| w["chips"] = w["chips"] + share }
      wnames = winners.map { |w| w["label"] }.join(" & ")
      verb = winners.size == 1 ? "wins" : "win"
      puts "  \e[1;32m★ #{wnames} #{verb} #{pot} chips with #{best_name}!\e[0m"
    end

    hand += 1
  end

  puts "\e[2m────────────────────────────────────────────────────────────────────\e[0m"
  puts "\e[1;37mFINAL STANDINGS (after #{num_hands} hands):\e[0m"
  si = 0
  while si < seats.size
    p = seats[si]
    delta = p["chips"] - 500
    sign = delta >= 0 ? "+#{delta}" : "#{delta}"
    puts "  #{seat_color(si, p["label"])}: \e[1m#{p["chips"]} chips\e[0m \e[2m(#{sign})\e[0m"
    si += 1
  end
  puts ""
ensure
  handles.each { |h| h.stop }
end
