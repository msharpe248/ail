# examples/ollama.ail.env — Live local Ollama (OpenAI-compatible /v1) + MCP + Skills
llm.local = {"driver": "openai", "url": "http://127.0.0.1:11434/v1", "model": "gemma4:31b-mlx", "timeout_ms": 120000}
mcp.repo_tools = {"transport": "stdio", "cmd": ["./ail", "run", "examples/mcp_repo_tools.ail", "--", "--stdio"]}
skills.local = {"driver": "dir", "paths": ["./examples/skills"]}
db.ollama_sessions = {"driver": "memory"}
