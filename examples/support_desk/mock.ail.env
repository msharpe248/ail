# examples/support_desk/mock.ail.env — Deterministic offline configuration
s1.router = {"driver": "mock", "rules": [{"match": "invoice", "result": {"queue": {"value": "billing", "confidence": 0.96}, "urgency": {"value": 4, "confidence": 0.90}}}], "default": {"queue": {"value": "account", "confidence": 0.50}, "urgency": {"value": 2, "confidence": 0.50}}}
llm.agent_model = {"driver": "mock", "script": [{"content": "", "tool_calls": [{"id": "tc1", "name": "lookup_policy", "arguments": {"topic": "billing"}}]}, {"content": "Refund initiated (3 business days). Ref 123-45-6789."}]}
embedder.docs = {"driver": "mock", "dim": 64}
vector_db.kb = {"driver": "memory", "metric": "cosine", "embedder": "docs"}
