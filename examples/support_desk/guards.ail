# examples/support_desk/guards.ail — Input & output safety guardrails

guard PIIGuard do
  check_input do |text, ctx|
    return reject("Prompt injection blocked") if text.downcase.include?("ignore previous instructions")
    allow
  end

  check_output do |text, ctx|
    if text.match?(/\b\d{3}-\d{2}-\d{4}\b/)
      return redact(text.gsub(/\b\d{3}-\d{2}-\d{4}\b/, "[REDACTED-SSN]"))
    end
    allow
  end
end
